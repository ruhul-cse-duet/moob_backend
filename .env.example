# ---- App ----
APP_NAME=WebImove
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DEBUG=true
# List the real frontend origins. "*" disables credentialed CORS, because no
# browser accepts a wildcard origin together with credentials.
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ---- Mongo (database-per-tenant) ----
MONGODB_URI=mongodb://localhost:27017
PLATFORM_DB_NAME=webimove_platform
# Atlas caps database names at 38 bytes; a 24-char tenant id follows this prefix,
# so keep it under 14 characters or tenant creation fails.
TENANT_DB_PREFIX=wm_t_

# ---- Security ----
# Docs are public when on. Leave unset: they follow ENVIRONMENT (off in production).
# ENABLE_DOCS=false
SECURITY_HEADERS=true
HSTS_MAX_AGE=31536000
# Turn on ONLY when a proxy you control (nginx / load balancer / Cloudflare) sets
# X-Forwarded-For. On a directly exposed app a caller can forge that header to
# dodge the login throttle and to write false addresses into the audit trail.
TRUST_PROXY_HEADERS=false

# Brute-force lockout, counted per (email + client IP) over a rolling window.
LOGIN_MAX_ATTEMPTS=8
LOGIN_ATTEMPT_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

# Enables POST /api/v1/admin/setup/super-admin, which is unauthenticated by
# necessity - there is no account to authenticate as yet. Leave EMPTY unless you
# are bootstrapping right now, and clear it afterwards; the caller must send the
# same value in an X-Setup-Token header. With it empty the endpoint is disabled
# and scripts_create_superadmin.py (shell access required) is the only way in.
PLATFORM_SETUP_TOKEN=

# ---- Seeded platform administrator ----
# Set both and the API creates this account the next time it boots, so a fresh
# database is never locked out of its own admin area. Creation only: if the
# address already exists the account is left untouched and the password below is
# ignored, because editing this file must not be a way to take over a live
# platform. Clear both once the account exists. The same values are what
# scripts_create_superadmin.py uses when run with no arguments.
# Use an address no consultant, partner or client will ever sign up with -
# sign-in checks administrators first, so a shared address locks that person out.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Platform Admin

# ---- Where the app is served ----
# Invitation and password-reset emails link here, so it must be an address the
# recipient can actually open - not this API. A Flutter web debug build picks a
# fresh port on every run, so pin one with
#   flutter run -d chrome --web-port 5173
# or set this to whatever port you are using. The app routes on the URL
# fragment, which is why the accept path starts with `#`.
FRONTEND_URL=http://localhost:5173
INVITE_ACCEPT_PATH=/#/auth/invite

# ---- JWT ----
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# Anyone holding this value can mint a valid token for any account, including
# the platform super admin. Never reuse it across environments.
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- OTP / SMTP ----
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=no-reply@webimove.com
SMTP_FROM_NAME=WebImove
SMTP_STARTTLS=true

# ---- OpenAI ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1500

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_...
# The browser tokenises the card with this before anything is posted, so a raw
# card number never reaches this server. It is meant to be public. Without it
# the payment screen tells the visitor card payment is unavailable and refuses
# to collect a card at all, because Stripe would reject the charge anyway.
# Use the key from the same mode as the secret key above — a test secret needs
# a test publishable key.
STRIPE_PUBLISHABLE_KEY=pk_test_...
# From `stripe listen` locally, or the endpoint's signing secret in the dashboard.
# Point the endpoint at POST /api/v1/webhooks/stripe. Without this the webhook
# rejects every event, so renewals and failed payments go unnoticed.
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
# Usually leave this empty. Prices are managed by the super admin in the platform
# dashboard, and the backend creates the matching Stripe Price on demand. Set an
# entry only to pin a hand-made Price for one plan/cycle; it then overrides the
# dashboard for that entry. Keys are "<plan>_<cycle>", e.g.:
#   STRIPE_PRICES={"professional_monthly":"price_1AbC..."}
STRIPE_PRICES={}
# Files are stored in MongoDB GridFS inside each tenant database.
MAX_UPLOAD_MB=25

# ---- Logging ----
# LOG_LEVEL is your application's level. Keep MONGO_LOG_LEVEL at WARNING unless you
# are debugging the driver - at DEBUG it prints a heartbeat per replica node every 10s.
LOG_LEVEL=INFO
MONGO_LOG_LEVEL=WARNING
HTTP_LOG_LEVEL=WARNING
ACCESS_LOG=true
