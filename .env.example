# ---- App ----
APP_NAME=WebImove
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DEBUG=true
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ---- Mongo (database-per-tenant) ----
MONGODB_URI=mongodb://localhost:27017
PLATFORM_DB_NAME=webimove_platform
TENANT_DB_PREFIX=webimove_tenant_

# ---- JWT ----
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- OTP / SMTP ----
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=no-reply@webimove.com
SMTP_FROM_NAME=WebImove
SMTP_STARTTLS=true

# ---- OpenAI ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1500

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
# Files are stored in MongoDB GridFS inside each tenant database.
MAX_UPLOAD_MB=25

# ---- Logging ----
# LOG_LEVEL is your application's level. Keep MONGO_LOG_LEVEL at WARNING unless you
# are debugging the driver - at DEBUG it prints a heartbeat per replica node every 10s.
LOG_LEVEL=INFO
MONGO_LOG_LEVEL=WARNING
HTTP_LOG_LEVEL=WARNING
ACCESS_LOG=true
