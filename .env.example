# ---- App ----
APP_NAME=WebImove
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DEBUG=true
# List the real frontend origins. "*" disables credentialed CORS, because no
# browser accepts a wildcard origin together with credentials.
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ---- Mongo (database-per-tenant) ----
MONGODB_URI=mongodb://localhost:27017
PLATFORM_DB_NAME=webimove_platform
# Atlas caps database names at 38 bytes; a 24-char tenant id follows this prefix,
# so keep it under 14 characters or tenant creation fails.
TENANT_DB_PREFIX=wm_t_

# ---- Security ----
# Docs are public when on. Leave unset: they follow ENVIRONMENT (off in production).
# ENABLE_DOCS=false
SECURITY_HEADERS=true
HSTS_MAX_AGE=31536000
# Turn on ONLY when a proxy you control (nginx / load balancer / Cloudflare) sets
# X-Forwarded-For. On a directly exposed app a caller can forge that header to
# dodge the login throttle and to write false addresses into the audit trail.
TRUST_PROXY_HEADERS=false

# Brute-force lockout, counted per (email + client IP) over a rolling window.
LOGIN_MAX_ATTEMPTS=8
LOGIN_ATTEMPT_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

# Enables POST /api/v1/admin/setup/super-admin, which is unauthenticated by
# necessity - there is no account to authenticate as yet. Leave EMPTY unless you
# are bootstrapping right now, and clear it afterwards; the caller must send the
# same value in an X-Setup-Token header. With it empty the endpoint is disabled
# and scripts_create_superadmin.py (shell access required) is the only way in.
PLATFORM_SETUP_TOKEN=

# ---- Seeded platform administrator ----
# Set both and the API creates this account the next time it boots, so a fresh
# database is never locked out of its own admin area. Creation only: if the
# address already exists the account is left untouched and the password below is
# ignored, because editing this file must not be a way to take over a live
# platform. Clear both once the account exists. The same values are what
# scripts_create_superadmin.py uses when run with no arguments.
# Use an address no consultant, partner or client will ever sign up with -
# sign-in checks administrators first, so a shared address locks that person out.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Platform Admin

# ---- Where the app is served ----
# Invitation and password-reset emails link here, so it must be an address the
# recipient can actually open - not this API. A Flutter web debug build picks a
# fresh port on every run, so pin one with
#   flutter run -d chrome --web-port 5173
# or set this to whatever port you are using. The app routes on the URL
# fragment, which is why the accept path starts with `#`.
FRONTEND_URL=http://localhost:5173
INVITE_ACCEPT_PATH=/#/auth/invite

# ---- JWT ----
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# Anyone holding this value can mint a valid token for any account, including
# the platform super admin. Never reuse it across environments.
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- OTP / SMTP ----
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=no-reply@webimove.com
SMTP_FROM_NAME=WebImove
SMTP_STARTTLS=true

# ---- OpenAI ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1500

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_...
# The browser tokenises the card with this before anything is posted, so a raw
# card number never reaches this server. It is meant to be public. Without it
# the payment screen tells the visitor card payment is unavailable and refuses
# to collect a card at all, because Stripe would reject the charge anyway.
# Use the key from the same mode as the secret key above — a test secret needs
# a test publishable key.
STRIPE_PUBLISHABLE_KEY=pk_test_...
# From `stripe listen` locally, or the endpoint's signing secret in the dashboard.
# Point the endpoint at POST /api/v1/webhooks/stripe. Without this the webhook
# rejects every event, so renewals and failed payments go unnoticed.
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
# Usually leave this empty. Prices are managed by the super admin in the platform
# dashboard, and the backend creates the matching Stripe Price on demand. Set an
# entry only to pin a hand-made Price for one plan/cycle; it then overrides the
# dashboard for that entry. Keys are "<plan>_<cycle>", e.g.:
#   STRIPE_PRICES={"professional_monthly":"price_1AbC..."}
STRIPE_PRICES={}
# Files are stored in MongoDB GridFS inside each tenant database.
MAX_UPLOAD_MB=25

# ---- Logging ----
# LOG_LEVEL is your application's level. Keep MONGO_LOG_LEVEL at WARNING unless you
# are debugging the driver - at DEBUG it prints a heartbeat per replica node every 10s.
LOG_LEVEL=INFO
MONGO_LOG_LEVEL=WARNING
HTTP_LOG_LEVEL=WARNING
ACCESS_LOG=true

# ---- Push notifications (Firebase Cloud Messaging, HTTP v1) ----
# Every notification the API writes is also pushed to the account's registered
# devices. Leave everything below empty and push is simply skipped: the in-app
# feed and the socket carry on exactly as before, and the app keeps registering
# its device tokens - so filling these in later turns push on with no redeploy
# of the app itself.
#
# Where these come from: Firebase console -> Project settings -> Service
# accounts -> "Generate new private key". That downloads a JSON file.
PUSH_ENABLED=true

# Option A (easiest): the path to that downloaded JSON, or the whole JSON on one
# line. If you set this, the three FCM_ fields below are not needed.
FCM_CREDENTIALS_JSON=

# Option B: the three fields out of that same JSON, named individually. This is
# the one to use on a host where you cannot upload a file (Render, Railway,
# Heroku). Paste the private key exactly as it appears in the JSON, escaped
# newlines and all - it is un-escaped for you.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# The Android notification channel id. Must match PushService in the Flutter app
# (lib/service/push/push_service.dart) or Android will not show a heads-up
# alert. Only change it in both places at once.
PUSH_ANDROID_CHANNEL_ID=webimove_default
PUSH_SOUND=default
# How long FCM keeps retrying a device that is offline. Seven days.
PUSH_TTL_SECONDS=604800
# The iOS bundle id, only needed when the APNs topic differs from the one
# Firebase derives from the project. Usually leave empty.
APNS_BUNDLE_ID=
# Sends to FCM's validate-only endpoint instead of a real device: proves the
# credentials and the payload without ringing anybody's phone.
PUSH_DRY_RUN=false
PUSH_MAX_CONCURRENCY=10
# Above this many recipients the per-device iOS badge number is skipped; it
# costs one query per account and a platform-wide announcement does not need it.
PUSH_BADGE_RECIPIENT_LIMIT=50

# ---- Keeping a free-tier instance awake ----
# Render stops a free service after 15 minutes with no inbound request. The app
# pings itself just under that window, which holds a running instance up. It
# cannot wake one that has already stopped - .github/workflows/keep-awake.yml is
# the half that can, because it runs somewhere else.
#
# On Render the URL is read from RENDER_EXTERNAL_URL automatically, so leave
# KEEPALIVE_URL empty. Locally it is off regardless: a loopback ping proves
# nothing, so a localhost URL is ignored.
#
# QUOTA: a free Render account gets 750 instance-hours a month shared across
# every free service. One service awake 24/7 is ~730 hours and fits; two do not.
KEEPALIVE_ENABLED=true
KEEPALIVE_URL=
KEEPALIVE_INTERVAL_MINUTES=12

# ---- Email transport ----
# WHY THIS EXISTS: Render blocks outbound ports 25, 465 and 587 to stop its
# platform being used for spam. Gmail offers SMTP on 465 and 587 and nothing
# else - so smtp.gmail.com is unreachable from Render and every send fails with
# "SMTPConnectTimeoutError". It is not a password problem. An HTTP API sends over
# 443, which nothing blocks.
#
# Leave EMAIL_PROVIDER empty: the transport is picked from whichever key below is
# filled in, and falls back to the SMTP_* settings when none are. Name a provider
# here only to force one when more than one key is present.
#   resend | brevo | sendgrid | smtp
EMAIL_PROVIDER=

# Pick ONE and paste its key. All three have a free tier.
#
# Resend - 3,000/month free. https://resend.com → API Keys.
#   Sending as your own address needs the domain verified with them; until then
#   set SMTP_FROM_EMAIL=onboarding@resend.dev, which works immediately.
RESEND_API_KEY=
# Brevo - 300/day free, works without a verified domain to start.
#   https://app.brevo.com → SMTP & API → API Keys.
BREVO_API_KEY=
# SendGrid - 100/day free. https://app.sendgrid.com → Settings → API Keys.
SENDGRID_API_KEY=

# The SMTP_* settings above are still used locally, and on any host that permits
# outbound SMTP. If you would rather keep SMTP on Render, Brevo and SendGrid both
# offer port 2525, which is not blocked - set SMTP_HOST/SMTP_PORT to theirs
# instead of Gmail's.
